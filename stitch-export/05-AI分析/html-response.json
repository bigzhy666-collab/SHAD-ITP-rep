  "dataString": "\u003c!DOCTYPE html\u003e\n\n\u003chtml class=\"dark\" lang=\"zh-CN\"\u003e\u003chead\u003e\n\u003cmeta charset=\"utf-8\"/\u003e\n\u003cmeta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/\u003e\n\u003ctitle\u003eSHAD · 智慧供热异常检测与辅助诊断平台 - AI分析详情 (A-03)\u003c/title\u003e\n\u003clink href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/\u003e\n\u003clink crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/\u003e\n\u003clink href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,400;0,500;0,600;0,700;1,400&amp;family=JetBrains+Mono:wght@400;500;600;700&amp;family=Space+Grotesk:wght@400;500;600;700&amp;display=swap\" rel=\"stylesheet\"/\u003e\n\u003clink href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\" rel=\"stylesheet\"/\u003e\n\u003cscript src=\"https://cdn.tailwindcss.com?plugins=forms,container-queries\"\u003e\u003c/script\u003e\n\u003cscript id=\"tailwind-config\"\u003e\n  tailwind.config = {\n    darkMode: \"class\",\n    theme: {\n      extend: {\n        colors: {\n          \"surface-base\": \"#0A0B0E\",\n          \"surface-canvas\": \"#101116\",\n          \"surface-card\": \"#14161B\",\n          \"surface-card-hover\": \"#1C1F26\",\n          \"surface-container\": \"#1B1D23\",\n          \"border-subtle\": \"#1B1D23\",\n          \"border-grid\": \"#2B2E36\",\n          \"primary\": \"#FB7A18\",\n          \"primary-dim\": \"#FFB877\",\n          \"metric-supply\": \"#FF7849\",\n          \"metric-return\": \"#00B4D8\",\n          \"metric-pressure\": \"#7C3AED\",\n          \"metric-flow\": \"#4EA8FF\",\n          \"urgent\": \"#EF4444\",\n          \"warning\": \"#F59E0B\",\n          \"real\": \"#10B981\",\n          \"on-surface\": \"#E8E9ED\",\n          \"on-surface-variant\": \"#C3C6CD\",\n          \"outline\": \"#8B8F99\"\n        },\n        fontFamily: {\n          sans: [\"Space Grotesk\", \"Barlow Condensed\", \"system-ui\", \"sans-serif\"],\n          mono: [\"JetBrains Mono\", \"DIN Alternate\", \"monospace\"],\n          condensed: [\"Barlow Condensed\", \"sans-serif\"]\n        },\n        borderRadius: {\n          DEFAULT: \"4px\",\n          sm: \"2px\",\n          md: \"4px\",\n          lg: \"4px\"\n        }\n      }\n    }\n  }\n\u003c/script\u003e\n\u003cstyle\u003e\n  :root {\n    --surface-base: #0A0B0E;\n    --surface-canvas: #101116;\n    --surface-card: #14161B;\n    --surface-card-hover: #1C1F26;\n    --border-grid: #2B2E36;\n    --border-subtle: #1B1D23;\n    --primary: #FB7A18;\n    --primary-dim: #FFB877;\n    --metric-supply: #FF7849;\n    --metric-return: #00B4D8;\n    --metric-pressure: #7C3AED;\n    --metric-flow: #4EA8FF;\n    --urgent: #EF4444;\n    --warning: #F59E0B;\n    --real: #10B981;\n    --outline: #8B8F99;\n    --on-surface: #E8E9ED;\n    --on-surface-variant: #C3C6CD;\n  }\n\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n  body {\n    background-color: var(--surface-base);\n    color: var(--on-surface);\n    font-family: 'Space Grotesk', system-ui, -apple-system, sans-serif;\n    font-size: 12px;\n    line-height: 1.45;\n    font-variant-numeric: tabular-nums;\n    -webkit-font-smoothing: antialiased;\n    overflow-x: hidden;\n    min-height: 100vh;\n  }\n\n  /* 40px 工控网格背景 */\n  .scada-grid-bg {\n    background-color: var(--surface-canvas);\n    background-image:\n      linear-gradient(to right, rgba(43, 46, 54, 0.22) 1px, transparent 1px),\n      linear-gradient(to bottom, rgba(43, 46, 54, 0.22) 1px, transparent 1px);\n    background-size: 40px 40px;\n  }\n\n  .material-symbols-outlined {\n    font-size: 16px;\n    vertical-align: middle;\n    line-height: 1;\n  }\n\n  /* 工业细边框卡片 */\n  .scada-card {\n    background: var(--surface-card);\n    border: 1px solid var(--border-grid);\n    border-radius: 4px;\n    position: relative;\n  }\n  .scada-card:hover {\n    border-color: #383D48;\n  }\n\n  .scada-card-header {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    padding: 8px 12px;\n    border-bottom: 1px solid var(--border-subtle);\n    background: rgba(10, 11, 14, 0.55);\n  }\n\n  .scada-card-title {\n    font-size: 12px;\n    font-weight: 700;\n    color: var(--on-surface);\n    letter-spacing: 0.02em;\n    display: flex;\n    align-items: center;\n    gap: 7px;\n  }\n\n  .tag-box {\n    width: 18px;\n    height: 18px;\n    border-radius: 2px;\n    background: rgba(251, 122, 24, 0.15);\n    border: 1px solid rgba(251, 122, 24, 0.4);\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    color: var(--primary);\n  }\n\n  .scada-btn {\n    border: 1px solid var(--border-grid);\n    background: #171A21;\n    color: var(--on-surface);\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 11px;\n    font-weight: 600;\n    padding: 4px 10px;\n    border-radius: 4px;\n    cursor: pointer;\n    transition: all 0.15s ease;\n    display: inline-flex;\n    align-items: center;\n    gap: 5px;\n  }\n  .scada-btn:hover {\n    background: #20242E;\n    border-color: var(--primary);\n    color: #FFF;\n  }\n  .scada-btn-primary {\n    background: var(--primary);\n    border-color: var(--primary);\n    color: #1A0B00;\n    font-weight: 700;\n  }\n  .scada-btn-primary:hover {\n    background: #FFA155;\n    color: #000;\n  }\n\n  .glow-alert {\n    filter: drop-shadow(0 0 6px rgba(239, 68, 68, 0.45));\n  }\n\u003c/style\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n\u003cdiv class=\"flex min-h-screen bg-surface-base\"\u003e\n\u003c!-- ==================== 1. SCADA 标准工控深色侧边栏 ==================== --\u003e\n\u003caside class=\"w-[236px] shrink-0 bg-[#0E1015] border-r border-border-grid flex flex-col h-screen sticky top-0 z-40 select-none\"\u003e\n\u003c!-- Brand / SCADA LOGO --\u003e\n\u003cdiv class=\"px-3.5 py-3 border-b border-border-grid flex items-center gap-3\"\u003e\n\u003c!-- 经典工业折线波形工控LOGO --\u003e\n\u003cdiv class=\"w-9 h-9 rounded-[4px] bg-[#171A21] border border-[#2B2E36] flex items-center justify-center relative overflow-hidden shadow-inner\"\u003e\n\u003csvg height=\"24\" viewbox=\"0 0 28 24\" width=\"28\"\u003e\n\u003cline stroke=\"#333842\" stroke-width=\"1\" x1=\"2\" x2=\"26\" y1=\"20\" y2=\"20\"\u003e\u003c/line\u003e\n\u003cline stroke=\"#333842\" stroke-width=\"1\" x1=\"3\" x2=\"3\" y1=\"4\" y2=\"20\"\u003e\u003c/line\u003e\n\u003cpolyline fill=\"none\" points=\"4,16 8,16 12,6 16,18 20,10 24,10\" stroke=\"#FB7A18\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"\u003e\u003c/polyline\u003e\n\u003ccircle cx=\"12\" cy=\"6\" fill=\"#EF4444\" r=\"2.5\" stroke=\"#FFF\" stroke-width=\"0.8\"\u003e\u003c/circle\u003e\n\u003c/svg\u003e\n\u003c/div\u003e\n\u003cdiv class=\"flex-1 min-w-0\"\u003e\n\u003cdiv class=\"text-[13px] font-bold text-white tracking-wide font-sans flex items-center justify-between\"\u003e\n\u003cspan\u003eSHAD · SMART\u003c/span\u003e\n\u003cspan class=\"text-[9px] px-1 py-0.2 bg-primary/20 text-primary border border-primary/40 font-mono rounded-[2px]\"\u003eV0.14\u003c/span\u003e\n\u003c/div\u003e\n\u003cdiv class=\"text-[9px] text-[#808898] font-mono tracking-tight flex items-center gap-1.5 mt-0.5\"\u003e\n\u003cspan class=\"w-1.5 h-1.5 rounded-full bg-real inline-block animate-pulse\"\u003e\u003c/span\u003e\n\u003cspan\u003eCONSOLE · 工业边缘\u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- 管网上下文快速锚定框 --\u003e\n\u003cdiv class=\"mx-2.5 mt-2.5 p-2 bg-[#12141A] border border-border-grid rounded-[4px]\"\u003e\n\u003cdiv class=\"flex items-center justify-between text-[9.5px] font-mono text-primary font-semibold mb-1\"\u003e\n\u003cspan class=\"flex items-center gap-1\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[11px]\"\u003eaccount_tree\u003c/span\u003e\n          受析管段 (PRD N-01)\n        \u003c/span\u003e\n\u003cspan class=\"text-real text-[9px] font-mono\"\u003eSCADA 联动\u003c/span\u003e\n\u003c/div\u003e\n\u003cdiv class=\"text-[11px] font-bold text-gray-200 truncate font-mono\"\u003e1号二次供热管段 (DN300)\u003c/div\u003e\n\u003cdiv class=\"text-[9px] text-gray-500 font-mono mt-0.5 flex justify-between\"\u003e\n\u003cspan\u003e城东高新片区 · K2+140\u003c/span\u003e\n\u003cspan class=\"text-primary-dim\"\u003e桩号: #029\u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- 侧边导航组 (AI分析激活态：高对比实色工业橙底，深黑字 #1A0B00，左粗深橙边框) --\u003e\n\u003cdiv class=\"flex-1 overflow-y-auto px-2 py-3 space-y-4\"\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"px-2 text-[9px] font-mono text-gray-500 uppercase tracking-widest mb-1.5 font-bold\"\u003e\n          核心监测模块\n        \u003c/div\u003e\n\u003cnav class=\"space-y-0.5 font-sans\"\u003e\n\u003c!-- 1. 总览看板 --\u003e\n\u003ca class=\"flex items-center gap-2.5 px-2.5 py-1.5 text-[11.5px] text-gray-400 hover:text-gray-100 hover:bg-[#161922] rounded-[4px] border-l-2 border-transparent transition-colors font-medium\" href=\"#\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[15px]\"\u003edashboard\u003c/span\u003e\n\u003cspan\u003e总览看板\u003c/span\u003e\n\u003c/a\u003e\n\u003c!-- 2. 管网管理 --\u003e\n\u003ca class=\"flex items-center gap-2.5 px-2.5 py-1.5 text-[11.5px] text-gray-400 hover:text-gray-100 hover:bg-[#161922] rounded-[4px] border-l-2 border-transparent transition-colors font-medium\" href=\"#\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[15px]\"\u003ehub\u003c/span\u003e\n\u003cspan\u003e管网管理\u003c/span\u003e\n\u003c/a\u003e\n\u003c!-- 3. 异常检测 --\u003e\n\u003ca class=\"flex items-center justify-between px-2.5 py-1.5 text-[11.5px] text-gray-400 hover:text-gray-100 hover:bg-[#161922] rounded-[4px] border-l-2 border-transparent transition-colors font-medium\" href=\"#\"\u003e\n\u003cdiv class=\"flex items-center gap-2.5\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[15px]\"\u003ewarning\u003c/span\u003e\n\u003cspan\u003e异常检测\u003c/span\u003e\n\u003c/div\u003e\n\u003cspan class=