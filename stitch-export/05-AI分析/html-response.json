\"184\"\u003e历史正常流体工况聚类区\u003c/text\u003e\n\u003c!-- 正常工况点 --\u003e\n\u003ccircle cx=\"150\" cy=\"175\" fill=\"#10B981\" opacity=\"0.6\" r=\"3\"\u003e\u003c/circle\u003e\n\u003ccircle cx=\"180\" cy=\"185\" fill=\"#10B981\" opacity=\"0.8\" r=\"3.5\"\u003e\u003c/circle\u003e\n\u003ccircle cx=\"210\" cy=\"172\" fill=\"#10B981\" opacity=\"0.7\" r=\"3\"\u003e\u003c/circle\u003e\n\u003ccircle cx=\"230\" cy=\"188\" fill=\"#10B981\" opacity=\"0.85\" r=\"4\"\u003e\u003c/circle\u003e\n\u003ccircle cx=\"245\" cy=\"176\" fill=\"#10B981\" opacity=\"0.6\" r=\"2.5\"\u003e\u003c/circle\u003e\n\u003ccircle cx=\"170\" cy=\"190\" fill=\"#10B981\" opacity=\"0.75\" r=\"3.5\"\u003e\u003c/circle\u003e\n\u003c!-- 理论流体力学拟合基线 (浅天蓝虚线) --\u003e\n\u003cpath d=\"M 230 180 C 350 160, 480 120, 680 40\" opacity=\"0.5\" stroke=\"#4EA8FF\" stroke-dasharray=\"4 4\" stroke-width=\"1.5\"\u003e\u003c/path\u003e\n\u003ctext fill=\"#4EA8FF\" font-family=\"JetBrains Mono\" font-size=\"9.5\" x=\"510\" y=\"85\"\u003e流体机理推演拟合线 (R²=0.91)\u003c/text\u003e\n\u003c!-- 异常漂移回归曲线 (鲜红强调) --\u003e\n\u003cpath class=\"glow-alert\" d=\"M 210 178 Q 440 130 670 48\" fill=\"none\" stroke=\"#EF4444\" stroke-width=\"2.5\"\u003e\u003c/path\u003e\n\u003c!-- 异常散点簇 (橙红过渡) --\u003e\n\u003ccircle cx=\"480\" cy=\"120\" fill=\"#F59E0B\" opacity=\"0.7\" r=\"4\"\u003e\u003c/circle\u003e\n\u003ccircle cx=\"530\" cy=\"100\" fill=\"#EF4444\" opacity=\"0.8\" r=\"4.5\"\u003e\u003c/circle\u003e\n\u003ccircle cx=\"580\" cy=\"85\" fill=\"#EF4444\" opacity=\"0.85\" r=\"5\"\u003e\u003c/circle\u003e\n\u003ccircle cx=\"620\" cy=\"65\" fill=\"#EF4444\" opacity=\"0.9\" r=\"5\"\u003e\u003c/circle\u003e\n\u003ccircle cx=\"650\" cy=\"52\" fill=\"#EF4444\" opacity=\"0.95\" r=\"5.5\"\u003e\u003c/circle\u003e\n\u003ccircle cx=\"670\" cy=\"48\" fill=\"#EF4444\" r=\"7\" stroke=\"#FFFFFF\" stroke-width=\"2\"\u003e\u003c/circle\u003e\n\u003c!-- 当前实测异动坐标挂牌 --\u003e\n\u003cg transform=\"translate(560, 10)\"\u003e\n\u003crect fill=\"#14161B\" height=\"42\" rx=\"3\" stroke=\"#EF4444\" stroke-width=\"1\" width=\"180\"\u003e\u003c/rect\u003e\n\u003ctext fill=\"#E8E9ED\" font-family=\"Space Grotesk\" font-size=\"10\" font-weight=\"bold\" x=\"10\" y=\"16\"\u003e测点实测异动坐标 (03:32)\u003c/text\u003e\n\u003ctext fill=\"#EF4444\" font-family=\"JetBrains Mono\" font-size=\"10\" font-weight=\"bold\" x=\"10\" y=\"32\"\u003eΔT = -4.6°C | +ΔQ = +14.4t/h\u003c/text\u003e\n\u003c/g\u003e\n\u003c/svg\u003e\n\u003c!-- 悬浮机理提示 --\u003e\n\u003cdiv class=\"absolute bottom-2.5 left-14 bg-[#14161B]/95 border border-border-grid rounded-[3px] px-2.5 py-1 text-[10.5px] font-mono text-gray-200 flex items-center space-x-2\"\u003e\n\u003cspan class=\"w-2 h-2 rounded-full bg-urgent animate-pulse\"\u003e\u003c/span\u003e\n\u003cspan\u003e水力平衡破坏：流量增加但热交换效能反常骤降（旁通旁路或阀芯失锁典型指征）\u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- 底栏相关系数参数明细 --\u003e\n\u003cdiv class=\"mt-2.5 pt-2 border-t border-border-grid grid grid-cols-1 md:grid-cols-3 gap-2 font-mono text-[10.5px]\"\u003e\n\u003cdiv class=\"p-1.5 rounded-[3px] bg-[#0C0E13] border border-border-grid flex justify-between\"\u003e\n\u003cspan class=\"text-gray-400\"\u003e皮尔逊负相关度:\u003c/span\u003e\n\u003cspan class=\"text-urgent font-bold\"\u003e-0.842 (极显著)\u003c/span\u003e\n\u003c/div\u003e\n\u003cdiv class=\"p-1.5 rounded-[3px] bg-[#0C0E13] border border-border-grid flex justify-between\"\u003e\n\u003cspan class=\"text-gray-400\"\u003e因果置信滞后:\u003c/span\u003e\n\u003cspan class=\"text-metric-flow font-bold\"\u003e110 秒 (水流传播延迟)\u003c/span\u003e\n\u003c/div\u003e\n\u003cdiv class=\"p-1.5 rounded-[3px] bg-[#0C0E13] border border-border-grid flex justify-between\"\u003e\n\u003cspan class=\"text-gray-400\"\u003e模型残差分布:\u003c/span\u003e\n\u003cspan class=\"text-warning font-bold\"\u003eRes &gt; 3.8σ (超界)\u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- 右侧 4列：模型局部敏感性归因 (SHAP贡献度横向柱状图) --\u003e\n\u003cdiv class=\"lg:col-span-4 scada-card flex flex-col justify-between\"\u003e\n\u003cdiv class=\"scada-card-header\"\u003e\n\u003cdiv class=\"scada-card-title\"\u003e\n\u003cspan class=\"tag-box\"\u003e\u003cspan class=\"material-symbols-outlined text-[13px]\"\u003ebar_chart\u003c/span\u003e\u003c/span\u003e\n\u003cspan\u003e模型局部敏感性归因 (SHAP)\u003c/span\u003e\n\u003c/div\u003e\n\u003cspan class=\"text-[9.5px] font-mono px-1.5 py-0.5 bg-primary/15 text-primary border border-primary/40 rounded-[2px] font-bold\"\u003eThermalNet-Mini\u003c/span\u003e\n\u003c/div\u003e\n\u003cdiv class=\"p-3 flex-1 flex flex-col justify-between space-y-3\"\u003e\n\u003cdiv\u003e\n\u003cp class=\"text-[11px] font-mono text-gray-400 mb-3\"\u003e\n                小模型对本次异动判定依据的物理参数贡献权重分解：\n              \u003c/p\u003e\n\u003c!-- 4个归因柱状条 --\u003e\n\u003cdiv class=\"space-y-3 font-mono text-[10.5px]\"\u003e\n\u003c!-- 1 --\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"flex justify-between items-center mb-1\"\u003e\n\u003cspan class=\"text-gray-200\"\u003e回水端温差突降梯度 [d(ΔT)/dt]\u003c/span\u003e\n\u003cspan class=\"text-primary font-bold\"\u003e+44.2%\u003c/span\u003e\n\u003c/div\u003e\n\u003cdiv class=\"w-full h-2 rounded-[2px] bg-[#0C0E13] overflow-hidden border border-border-grid\"\u003e\n\u003cdiv class=\"h-full bg-primary rounded-[2px]\" style=\"width: 88%;\"\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- 2 --\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"flex justify-between items-center mb-1\"\u003e\n\u003cspan class=\"text-gray-200\"\u003e次支线反常流量扰动 [ΔQ_sub]\u003c/span\u003e\n\u003cspan class=\"text-metric-flow font-bold\"\u003e+31.6%\u003c/span\u003e\n\u003c/div\u003e\n\u003cdiv class=\"w-full h-2 rounded-[2px] bg-[#0C0E13] overflow-hidden border border-border-grid\"\u003e\n\u003cdiv class=\"h-full bg-metric-flow rounded-[2px]\" style=\"width: 63%;\"\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- 3 --\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"flex justify-between items-center mb-1\"\u003e\n\u003cspan class=\"text-gray-200\"\u003e末端阀后压差高频抖动 [P_diff_std]\u003c/span\u003e\n\u003cspan class=\"text-metric-pressure font-bold\"\u003e+16.4%\u003c/span\u003e\n\u003c/div\u003e\n\u003cdiv class=\"w-full h-2 rounded-[2px] bg-[#0C0E13] overflow-hidden border border-border-grid\"\u003e\n\u003cdiv class=\"h-full bg-metric-pressure rounded-[2px]\" style=\"width: 32%;\"\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- 4 --\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"flex justify-between items-center mb-1\"\u003e\n\u003cspan class=\"text-gray-200\"\u003e一次侧热源母管供水温漂 [T_prim]\u003c/span\u003e\n\u003cspan class=\"text-gray-400 font-bold\"\u003e+7.8%\u003c/span\u003e\n\u003c/div\u003e\n\u003cdiv class=\"w-full h-2 rounded-[2px] bg-[#0C0E13] overflow-hidden border border-border-grid\"\u003e\n\u003cdiv class=\"h-full bg-gray-500 rounded-[2px]\" style=\"width: 15%;\"\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- 机理判别方程约束框 --\u003e\n\u003cdiv class=\"p-2.5 rounded-[4px] bg-[#0C0E13] border border-border-grid font-mono\"\u003e\n\u003cdiv class=\"text-[9.5px] text-gray-500 flex justify-between mb-1\"\u003e\n\u003cspan\u003e机理判别方程约束:\u003c/span\u003e\n\u003cspan class=\"text-real font-bold\"\u003e满足热力守恒\u003c/span\u003e\n\u003c/div\u003e\n\u003cdiv class=\"text-[10px] text-gray-300 bg-[#14161C] p-2 rounded-[2px] border border-border-subtle leading-relaxed\"\u003e\n                Q_h = c·m·(T_s - T_r)\u003cbr/\u003e\n\u003cspan class=\"text-urgent font-bold\"\u003em ↑ 8.3% 时 Q_h ↓ 14.2%\u003c/span\u003e\u003cbr/\u003e\n\u003cspan class=\"text-gray-500\"\u003e推论：管段未充分流经换热末端，发生短路旁通\u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/section\u003e\n\u003c!-- ==================== 4. 可能原因研判 (自研 ThermalNet-Mini 模型推测) ==================== --\u003e\n\u003csection class=\"space-y-2\"\u003e\n\u003cdiv class=\"flex items-center justify-between\"\u003e\n\u003cdiv class=\"text-[12px] font-bold text-gray-200 flex items-center gap-2\"\u003e\n\u003cspan class=\"tag-box\"\u003e\u003cspan class=\"material-symbols-outlined text-[13px]\"\u003epsychology_alt\u003c/span\u003e\u003c/span\u003e\n\u003cspan\u003e可能原因研判 (自研 ThermalNet-Mini 模型推测)\u003c/span\u003e\n\u003c/div\u003e\n\u003cspan class=\"text-[10px] font-mono text-gray-500\"\u003e按综合置信度从高到低排序\u003c/span\u003e\n\u003c/div\u003e\n\u003cdiv class=\"grid grid-cols-1 md:grid-cols-2 gap-3\"\u003e\n\u003c!-- 原因 1：87.4% (高置信度红框) --\u003e\n\u003cdiv class=\"scada-card border-l-4 border-l-urgent p-3 bg-gradient-to-r from-urgent/5 to-transparent\"\u003e\n\u003cdiv class=\"flex items-start justify-between mb-2\"\u003e\n\u003cdiv class=\"flex items-center gap-2\"\u003e\n\u003cspan class=\"w-5 h-5 rounded-[2px] bg-urgent text-black font-bold font-mono text-[11px] flex items-center justify-center\"\u003e1\u003c/span\u003e\n\u003ch4 class=\"text-[12.5px] font-bold text-gray-100\"\u003e次干支路电动调节阀开度异常扰动\u003c/h4\u003e\n\u003c/div\u003e\n\u003cspan class=\"inline-flex items-center gap-1 px-2 py-0.5 rounded-[2px] text-[10px] font-mono font-bold bg-urgent/20 border border-urgent/40 text-urgent\"\u003e\n\u003cspan class=\"w-1.5 h-1.5 rounded-full bg-urgent animate-pulse\"\u003e\u003c/span\u003e\n                发生概率: 很高 (87.4%)\n              \u003c/span\u003e\n\u003c/div\u003e\n\u003cdiv class=\"space-y-2 text-[11px]\"\u003e\n\u003cdiv class=\"p-2 rounded-[3px] bg-[#0A0C10] border border-border-grid text-gray-300 leading-relaxed font-sans\"\u003e\n\u003cspan class=\"text-gray-500 font-mono text-[10px] block mb-0.5\"\u003e模型推演依据：\u003c/span\u003e\n                监测到该支路流量反常增加（+14.4 t/h）的同时，供回水换热效率显著衰减（热负荷不增反降）。机理模型特征显示高度匹配\u003cstrong class=\"text-urgent font-semibold\"\u003e电动执行机构反馈信号虚标或阀瓣卡涩失控\u003c/strong\u003e，导致阀门实际过度开大，破坏二次管网水力平衡并引起临近换热站欠流。\n              \u003c/div\u003e\n\u003cdiv class=\"grid grid-cols-2 gap-2 font-mono text-[10px]\"\u003e\n\u003cdiv class=\"p-1.5 rounded-[2px] bg-[#0C0E13] border border-border-grid\"\u003e\n\u003cdiv class=\"text-gray-500 text-[9px]\"\u003e执行器指令反馈差\u003c/div\u003e\n\u003cdiv class=\"text-urgent font-bold mt-0.5\"\u003e反馈值 42% ≠ 期望 25%\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"p-1.5 rounded-[2px] bg-[#0C0E13] border border-border-grid\"\u003e\n\u003cdiv class=\"text-gray-500 text-[9px]\"\u003e水力失调度指标 (X_g)\u003c/div\u003e\n\u003cdiv class=\"text-warning font-bold mt-0.5\"\u003e1.34 (超越上限 1.15)\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- 原因 2：62.1% (中置信度橙框) --\u003e\n\u003cdiv class=\"scada-card border-l-4 border-l-warning p-3 bg-gradient-to-r from-warning/5 to-transparent\"\u003e\n\u003cdiv class=\"flex items-start justify-between mb-2\"\u003e\n\u003cdiv class=\"flex items-center gap-2\"\u003e\n\u003cspan class=\"w-5 h-5 rounded-[2px] bg-warning text-black font-bold font-mono text-[11px] flex items-center justify-center\"\u003e2\u003c/span\u003e\n\u003ch4 class=\"text-[12.5px] font-bold text-gray-100\"\u003e用户端旁通阀轻度内漏窜水\u003c/h4\u003e\n\u003c/div\u003e\n\u003cspan class=\"inline-flex items-center gap-1 px-2 py-0.5 rounded-[2px] text-[10px] font-mono font-bold bg-warning/20 border border-warning/40 text-warning\"\u003e\n\u003cspan class=\"w-1.5 h-1.5 rounded-full bg-warning\"\u003e\u003c/span\u003e\n                发生概率: 中等 (62.1%)\n              \u003c/span\u003e\n\u003c/div\u003e\n\u003cdiv class=\"space-y-2 text-[11px]\"\u003e\n\u003cdiv class=\"p-2 rounded-[3px] bg-[#0A0C10] border border-border-grid text-gray-300 leading-relaxed font-sans\"\u003e\n\u003cspan class=\"text-gray-500 font-mono text-[10px] block mb-0.5\"\u003e模型推演依据：\u003c/span\u003e\n                末端大口径检修旁通阀或末端混水旁路止回阀若发生密封老化，供水高压热水将直接短路串入回水管线。模型捕捉到\u003cstrong class=\"text-warning font-semibold\"\u003e低负荷工况时段供回水温差骤缩（ΔT 从 32°C 降至 21°C）\u003c/strong\u003e，该短路循环水流稀释了回温，与典型微泄漏水动力学响应曲线吻合度达 62.1%。\n              \u003c/div\u003e\n\u003cdiv class=\"grid grid-cols-2 gap-2 font-mono text-[10px]\"\u003e\n\u003cdiv class=\"p-1.5 rounded-[2px] bg-[#0C0E13] border border-border-grid\"\u003e\n\u003cdiv class=\"text-gray-500 text-[9px]\"\u003e旁通回窜估算流量\u003c/div\u003e\n\u003cdiv class=\"text-warning font-bold mt-0.5\"\u003e约 8.2 ~ 11.5 t/h\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"p-1.5 rounded-[2px] bg-[#0C0E13] border border-border-grid\"\u003e\n\u003cdiv class=\"text-gray-500 text-[9px]\"\u003e温降响应衰减指数\u003c/div\u003e\n\u003cdiv class=\"text-gray-200 font-bold mt-0.5\"\u003eτ = 8.4 min (高速冲刷)\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/section\u003e\n\u003c!-- ==================== 5. 现场核查方向与运维建议 (三项工程步骤) ==================== --\u003e\n\u003csection class=\"scada-card\"\u003e\n\u003cdiv class=\"scada-card-header\"\u003e\n\u003cdiv class=\"scada-card-title\"\u003e\n\u003cspan class=\"tag-box\"\u003e\u003cspan class=\"material-symbols-outlined text-[13px]\"\u003ebuild_circle\u003c/span\u003e\u003c/span\u003e\n\u003cspan\u003e现场核查方向与工程运维处置建议\u003c/span\u003e\n\u003c/div\u003e\n\u003cspan class=\"text-[9.5px] font-mono text-gray-500\"\u003e已生成现场巡检工单预草案\u003c/span\u003e\n\u003c/div\u003e\n\u003cdiv class=\"p-3 grid grid-cols-1 md:grid-cols-3 gap-3 font-sans\"\u003e\n\u003c!-- 处置措施 1 --\u003e\n\u003cdiv class=\"bg-[#0C0E13] border border-border-grid p-2.5 rounded-[4px] flex flex-col justify-between\"\u003e\n\u003cdiv class=\"space-y-1.5\"\u003e\n\u003cdiv class=\"flex items-center justify-between font-mono text-[10px]\"\u003e\n\u003cspan class=\"text-primary font-bold flex items-center gap-1\"\u003e\n\u003cspan class=\"w-1.5 h-1.5 rounded-full bg-primary\"\u003e\u003c/span\u003e 排查优先级 01\n                \u003c/span\u003e\n\u003cspan class=\"text-urgent bg-urgent/15 px-1 py-0.2 rounded border border-urgent/30 font-bold\"\u003e现场首选\u003c/span\u003e\n\u003c/div\u003e\n\u003ch5 class=\"text-[12px] font-bold text-gray-100\"\u003e3号换热站调节阀反馈核查\u003c/h5\u003e\n\u003cp class=\"text-[11px] text-gray-400 leading-normal\"\u003e\n                调度巡检员前往 3号换热站（测点编号 VLV-03-SEC），重点核验电动执行机构实际开度标尺与 SCADA 远程反馈开度是否一致；进行全行程标定，排除连杆松动或阀芯脱落。\n              \u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"mt-3 pt-2 border-t border-border-grid flex items-center justify-between font-mono text-[10px]\"\u003e\n\u003cspan class=\"text-gray-500\"\u003e时长: 25 min\u003c/span\u003e\n\u003cbutton class=\"text-primary hover:underline font-bold flex items-center gap-0.5\"\u003e\n                派发工单 \u003cspan class=\"material-symbols-outlined text-[12px]\"\u003earrow_forward\u003c/span\u003e\n\u003c/button\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- 处置措施 2 --\u003e\n\u003cdiv class=\"bg-[#0C0E13] border border-border-grid p-2.5 rounded-[4px] flex flex-col justify-between\"\u003e\n\u003cdiv class=\"space-y-1.5\"\u003e\n\u003cdiv class=\"flex items-center justify-between font-mono text-[10px]\"\u003e\n\u003cspan class=\"text-primary font-bold flex items-center gap-1\"\u003e\n\u003cspan class=\"w-1.5 h-1.5 rounded-full bg-primary\"\u003e\u003c/span\u003e 排查优先级 02\n                \u003c/span\u003e\n\u003cspan class=\"text-warning bg-warning/15 px-1 py-0.2 rounded border border-warning/30 font-bold\"\u003e红外扫描\u003c/span\u003e\n\u003c/div\u003e\n\u003ch5 class=\"text-[12px] font-bold text-gray-100\"\u003e末端法兰内漏红外扫描\u003c/h5\u003e\n\u003cp class=\"text-[11px] text-gray-400 leading-normal\"\u003e\n                使用便携式红外热像仪对 DN300 管段末端手动旁通连通管（BYPASS-DN150）及混水止回阀前后管壁测温。若常闭旁通管表面温度高于 55°C，即可确认为止回阀阀座冲蚀内漏窜水。\n              \u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"mt-3 pt-2 border-t border-border-grid flex items-center justify-between font-mono text-[10px]\"\u003e\n\u003cspan class=\"text-gray-500\"\u003e时长: 15 min\u003c/span\u003e\n\u003cbutton class=\"text-primary hover:underline font-bold flex items-center gap-0.5\"\u003e\n                指派设备巡检 \u003cspan class=\"material-symbols-outlined text-[12px]\"\u003earrow_forward\u003c/span\u003e\n\u003c/button\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- 处置措施 3 --\u003e\n\u003cdiv class=\"bg-[#0C0E13] border border-border-grid p-2.5 rounded-[4px] flex flex-col justify-between\"\u003e\n\u003cdiv class=\"space-y-1.5\"\u003e\n\u003cdiv class=\"flex items-center justify-between font-mono text-[10px]\"\u003e\n\u003cspan class=\"text-primary font-bold flex items-center gap-1\"\u003e\n\u003cspan class=\"w-1.5 h-1.5 rounded-full bg-primary\"\u003e\u003c/span\u003e 控制临时对策\n                \u003c/span\u003e\n\u003cspan class=\"text-metric-flow bg-metric-flow/15 px-1 py-0.2 rounded border border-metric-flow/30 font-bold\"\u003e控制中心\u003c/span\u003e\n\u003c/div\u003e\n\u003ch5 class=\"text-[12px] font-bold text-gray-100\"\u003e临时微调总流量对策\u003c/h5\u003e\n\u003cp class=\"text-[11px] text-gray-400 leading-normal\"\u003e\n                在巡检人员抵达现场确认前，控制室调度员将该二次回路主变频循环泵频率从 48.5Hz 回调至 44.0Hz，限制最大瞬时流量至 165t/h，以防止管网持续水力失调危及末梢换热。\n              \u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class=\"mt-3 pt-2 border-t border-border-grid flex items-center justify-between font-mono text-[10px]\"\u003e\n\u003cspan class=\"text-gray-500\"\u003e调度长双人复核\u003c/span\u003e\n\u003cbutton class=\"text-metric-flow hover:underline font-bold flex items-center gap-0.5\"\u003e\n                申请调控 \u003cspan class=\"material-symbols-outlined text-[12px]\"\u003etune\u003c/span\u003e\n\u003c/button\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/section\u003e\n\u003c!-- ==================== 6. 严谨工业声明与免责提示 ==================== --\u003e\n\u003cfooter class=\"p-2.5 rounded-[4px] bg-[#101217] border border-border-grid flex items-start space-x-2.5 text-[10.5px] font-mono text-gray-400\"\u003e\n\u003cspan class=\"material-symbols-outlined text-primary text-[15px] shrink-0 mt-0.5\"\u003einfo\u003c/span\u003e\n\u003cdiv class=\"leading-relaxed\"\u003e\n\u003cp class=\"text-gray-300\"\u003e\n\u003cstrong\u003e注：\u003c/strong\u003e本结论由 \u003cspan class=\"font-bold text-primary\"\u003eThermalNet-Mini v1.8\u003c/span\u003e 供热水网自研小模型提供辅助诊断推演。分析结果明确区分\u003cstrong\u003e传感器客观时序数据事实\u003c/strong\u003e与\u003cstrong\u003e机理拓扑模型推测\u003c/strong\u003e，不代表不可逆的物理确定性结论。请一线运维工程师务必结合现场工况、管线压力表就地读数及红外检测结果综合复核后执行管网动作。\n          \u003c/p\u003e\n\u003cdiv class=\"mt-1 flex flex-wrap items-center gap-x-4 text-[9.5px] text-gray-500\"\u003e\n\u003cspan\u003e机理推理引擎校验哈希: \u003cspan class=\"text-gray-300\"\u003eSHA256:7f3b0c8...e1a2\u003c/span\u003e\u003c/span\u003e\n\u003cspan\u003e小模型参数量: 4.8M Params\u003c/span\u003e\n\u003cspan\u003e执行环境: 厂站边缘计算边缘机 (Edge-04)\u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/footer\u003e\n\u003c/div\u003e\n\u003c/main\u003e\n\u003c/div\u003e\n\u003cscript\u003e\n  // 实时工业时钟\n  function updateClock() {\n    const d = new Date();\n    const pad = n =\u003e String(n).padStart(2, '0');\n    const el = document.getElementById('liveClock');\n    if (el) {\n      el.textContent = `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;\n    }\n  }\n  setInterval(updateClock, 1000);\n  updateClock();\n\u003c/script\u003e\n\u003c/body\u003e\u003c/html\u003e"
}
