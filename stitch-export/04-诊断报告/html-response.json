{
  "dataString": "\u003c!DOCTYPE html\u003e\n\n\u003chtml class=\"dark\" lang=\"zh-CN\"\u003e\u003chead\u003e\n\u003cmeta charset=\"utf-8\"/\u003e\n\u003cmeta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/\u003e\n\u003ctitle\u003eSHAD · 智慧供热异常检测与辅助诊断平台 - 诊断报告详情与导出归档 (R-03)\u003c/title\u003e\n\u003clink href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/\u003e\n\u003clink crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/\u003e\n\u003clink href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,400;0,500;0,600;0,700;1,400&amp;family=JetBrains+Mono:wght@400;500;600;700&amp;family=Space+Grotesk:wght@400;500;600;700&amp;display=swap\" rel=\"stylesheet\"/\u003e\n\u003clink href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\" rel=\"stylesheet\"/\u003e\n\u003c!-- Tailwind CSS --\u003e\n\u003cscript src=\"https://cdn.tailwindcss.com?plugins=forms,container-queries\"\u003e\u003c/script\u003e\n\u003cscript id=\"tailwind-config\"\u003e\n  tailwind.config = {\n    darkMode: \"class\",\n    theme: {\n      extend: {\n        colors: {\n          \"surface-base\": \"#0A0B0E\",\n          \"surface-canvas\": \"#101116\",\n          \"surface-card\": \"#14161B\",\n          \"surface-card-hover\": \"#1C1F26\",\n          \"surface-container\": \"#1B1D23\",\n          \"border-subtle\": \"#1E222A\",\n          \"border-grid\": \"#2B2E36\",\n          \"primary\": \"#FB7A18\",\n          \"primary-dim\": \"#FFB877\",\n          \"metric-supply\": \"#FF7849\",\n          \"metric-return\": \"#00B4D8\",\n          \"metric-pressure\": \"#A855F7\",\n          \"metric-flow\": \"#10B981\",\n          \"urgent\": \"#EF4444\",\n          \"warning\": \"#F59E0B\",\n          \"real\": \"#10B981\",\n          \"on-surface\": \"#E2E2E9\",\n          \"on-surface-variant\": \"#9CA3AF\",\n          \"outline\": \"#6B7280\"\n        },\n        fontFamily: {\n          sans: [\"Space Grotesk\", \"system-ui\", \"sans-serif\"],\n          mono: [\"JetBrains Mono\", \"monospace\"],\n          condensed: [\"Barlow Condensed\", \"sans-serif\"]\n        },\n        borderRadius: {\n          DEFAULT: \"4px\",\n          sm: \"2px\",\n          md: \"3px\",\n          lg: \"4px\"\n        }\n      }\n    }\n  }\n\u003c/script\u003e\n\u003cstyle\u003e\n  :root {\n    --bg-base: #0A0B0E;\n    --bg-canvas: #101116;\n    --bg-card: #14161B;\n    --border-grid: #2B2E36;\n    --border-subtle: #1E222A;\n    --primary: #FB7A18;\n    --urgent: #EF4444;\n    --warning: #F59E0B;\n    --real: #10B981;\n    --return: #00B4D8;\n    --pressure: #A855F7;\n  }\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n  body {\n    background-color: var(--bg-base);\n    color: #E2E2E9;\n    font-family: 'Space Grotesk', system-ui, -apple-system, sans-serif;\n    font-size: 12px;\n    line-height: 1.45;\n    -webkit-font-smoothing: antialiased;\n    min-height: 100vh;\n  }\n  ::selection { background: rgba(251, 122, 24, 0.3); color: #FFF; }\n  \n  /* 40px*40px SCADA 网格 */\n  .scada-grid-bg {\n    background-color: var(--bg-canvas);\n    background-image: \n      linear-gradient(to right, rgba(43, 46, 54, 0.25) 1px, transparent 1px),\n      linear-gradient(to bottom, rgba(43, 46, 54, 0.25) 1px, transparent 1px);\n    background-size: 40px 40px;\n  }\n\n  .material-symbols-outlined {\n    font-size: 16px;\n    vertical-align: middle;\n  }\n\n  /* 工业细边框卡片 */\n  .scada-card {\n    background: var(--bg-card);\n    border: 1px solid var(--border-grid);\n    border-radius: 4px;\n    position: relative;\n    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.45);\n  }\n  .scada-card:hover {\n    border-color: #383D48;\n  }\n\n  .scada-card-header {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    padding: 8px 12px;\n    border-bottom: 1px solid var(--border-grid);\n    background: rgba(10, 11, 14, 0.55);\n  }\n  .scada-card-title {\n    font-size: 12.5px;\n    font-weight: 700;\n    color: #F3F4F6;\n    letter-spacing: 0.02em;\n    display: flex;\n    align-items: center;\n    gap: 7px;\n  }\n  .scada-card-title .tag-box {\n    width: 20px;\n    height: 20px;\n    border-radius: 2px;\n    background: rgba(251, 122, 24, 0.15);\n    border: 1px solid rgba(251, 122, 24, 0.45);\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    color: var(--primary);\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 10px;\n    font-weight: 700;\n  }\n\n  /* 工控按键 */\n  .scada-btn {\n    border: 1px solid var(--border-grid);\n    background: #171A21;\n    color: #E2E2E9;\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 11px;\n    font-weight: 600;\n    padding: 4px 10px;\n    border-radius: 3px;\n    cursor: pointer;\n    transition: all 0.15s ease;\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    white-space: nowrap;\n  }\n  .scada-btn:hover {\n    background: #20242E;\n    border-color: var(--primary);\n    color: #FFF;\n  }\n  .scada-btn-primary {\n    background: var(--primary);\n    border-color: var(--primary);\n    color: #100600;\n    font-weight: 700;\n  }\n  .scada-btn-primary:hover {\n    background: #FFA155;\n    color: #000;\n    border-color: #FFA155;\n  }\n\n  .status-dot-ok {\n    width: 6px;\n    height: 6px;\n    border-radius: 50%;\n    background: var(--real);\n    box-shadow: 0 0 6px rgba(16, 185, 129, 0.8);\n    animation: pulseSlow 2s infinite ease-in-out;\n  }\n  @keyframes pulseSlow {\n    0%, 100% { opacity: 1; transform: scale(1); }\n    50% { opacity: 0.35; transform: scale(0.85); }\n  }\n\u003c/style\u003e\n\u003c/head\u003e\n\u003cbody class=\"bg-surface-base text-on-surface flex min-h-screen\"\u003e\n\u003c!-- ==================== 1. SCADA 标准工控深色侧边栏 ==================== --\u003e\n\u003caside class=\"w-[240px] shrink-0 bg-[#0E1015] border-r border-border-grid flex flex-col h-screen sticky top-0 z-40 select-none\"\u003e\n\u003c!-- Brand / SCADA LOGO --\u003e\n\u003cdiv class=\"px-4 py-3.5 border-b border-border-grid flex items-center gap-3\"\u003e\n\u003cdiv class=\"w-9 h-9 rounded-[3px] bg-[#171A21] border border-[#2B2E36] flex items-center justify-center relative overflow-hidden shadow-inner\"\u003e\n\u003csvg height=\"24\" viewbox=\"0 0 28 24\" width=\"28\"\u003e\n\u003cline stroke=\"#333842\" stroke-width=\"1\" x1=\"2\" x2=\"26\" y1=\"20\" y2=\"20\"\u003e\u003c/line\u003e\n\u003cline stroke=\"#333842\" stroke-width=\"1\" x1=\"3\" x2=\"3\" y1=\"4\" y2=\"20\"\u003e\u003c/line\u003e\n\u003cpolyline fill=\"none\" points=\"4,16 8,16 12,6 16,18 20,10 24,10\" stroke=\"#FB7A18\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"\u003e\u003c/polyline\u003e\n\u003ccircle cx=\"12\" cy=\"6\" fill=\"#EF4444\" r=\"2.5\" stroke=\"#FFF\" stroke-width=\"0.8\"\u003e\u003c/circle\u003e\n\u003c/svg\u003e\n\u003c/div\u003e\n\u003cdiv class=\"flex-1 min-w-0\"\u003e\n\u003cdiv class=\"text-[13px] font-bold text-white tracking-wide font-sans flex items-center justify-between\"\u003e\n\u003cspan\u003eSHAD · SMART\u003c/span\u003e\n\u003cspan class=\"text-[9px] px-1 py-0.2 bg-primary/20 text-primary border border-primary/40 font-mono rounded-[2px]\"\u003eV0.14\u003c/span\u003e\n\u003c/div\u003e\n\u003cdiv class=\"text-[9.5px] text-[#808898] font-mono tracking-tight flex items-center gap-1.5 mt-0.5\"\u003e\n\u003cspan class=\"w-1.5 h-1.5 rounded-full bg-real inline-block\"\u003e\u003c/span\u003e\n\u003cspan\u003eCONSOLE · 模拟数据\u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- 管网上下文快速锚定框 --\u003e\n\u003cdiv class=\"mx-3 mt-3 p-2 bg-[#12141A] border border-border-grid rounded-[3px]\"\u003e\n\u003cdiv class=\"flex items-center justify-between text-[9.5px] font-mono text-primary font-semibold mb-1\"\u003e\n\u003cspan class=\"flex items-center gap-1\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[11px]\"\u003edevice_hub\u003c/span\u003e\n        受析管段 (PRD N-01)\n      \u003c/span\u003e\n\u003cspan class=\"text-real text-[9px] font-mono\"\u003eSCADA 联动\u003c/span\u003e\n\u003c/div\u003e\n\u003cdiv class=\"text-[11px] font-bold text-gray-200 truncate font-mono\"\u003e1号二次供热管段 (DN300)\u003c/div\u003e\n\u003cdiv class=\"text-[9.5px] text-gray-500 font-mono mt-0.5 flex justify-between\"\u003e\n\u003cspan\u003e城北主力网 · K2+140\u003c/span\u003e\n\u003cspan class=\"text-primary-dim\"\u003e桩号: #029\u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- 侧边导航组 --\u003e\n\u003cdiv class=\"flex-1 overflow-y-auto px-2 py-3 space-y-4\"\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"px-2 text-[9px] font-mono text-gray-500 uppercase tracking-widest mb-1.5 font-bold\"\u003e\n        核心监测模块\n      \u003c/div\u003e\n\u003cnav class=\"space-y-0.5 font-sans\"\u003e\n\u003ca class=\"flex items-center gap-2.5 px-2.5 py-1.5 text-[11.5px] text-gray-400 hover:text-gray-100 hover:bg-[#161922] rounded-[3px] border-l-2 border-transparent transition-colors font-medium\" href=\"#\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[15px]\"\u003edashboard\u003c/span\u003e\n\u003cspan\u003e总览看板 (Overview)\u003c/span\u003e\n\u003c/a\u003e\n\u003ca class=\"flex items-center gap-2.5 px-2.5 py-1.5 text-[11.5px] text-gray-400 hover:text-gray-100 hover:bg-[#161922] rounded-[3px] border-l-2 border-transparent transition-colors font-medium\" href=\"#\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[15px]\"\u003ehub\u003c/span\u003e\n\u003cspan\u003e管网拓扑管理\u003c/span\u003e\n\u003c/a\u003e\n\u003ca class=\"flex items-center justify-between px-2.5 py-1.5 text-[11.5px] text-gray-400 hover:text-gray-100 hover:bg-[#161922] rounded-[3px] border-l-2 border-transparent transition-colors font-medium\" href=\"#\"\u003e\n\u003cdiv class=\"flex items-center gap-2.5\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[15px]\"\u003ewarning\u003c/span\u003e\n\u003cspan\u003e异常检测研判\u003c/span\u003e\n\u003c/div\u003e\n\u003cspan class=\"text-[9.5px] font-mono px-1 py-0.5 bg-urgent/20 text-urgent border border-urgent/40 rounded-[2px] font-bold\"\u003e2 待研判\u003c/span\u003e\n\u003c/a\u003e\n\u003ca class=\"flex items-center gap-2.5 px-2.5 py-1.5 text-[11.5px] text-gray-400 hover:text-gray-100 hover:bg-[#161922] rounded-[3px] border-l-2 border-transparent transition-colors font-medium\" href=\"#\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[15px]\"\u003epsychology\u003c/span\u003e\n\u003cspan\u003e自研小模型 AI 诊断\u003c/span\u003e\n\u003c/a\u003e\n\u003c!-- 当前诊断报告页处于激活高亮态：实色工业橙底黑字 (#FB7A18) --\u003e\n\u003ca class=\"flex items-center gap-2.5 px-2.5 py-2 text-[11.5px] font-bold rounded-[3px] bg-primary text-[#100600] border-l-2 border-white shadow-sm\" href=\"#\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[15px]\"\u003eassessment\u003c/span\u003e\n\u003cspan\u003e诊断报告归档 (Reports)\u003c/span\u003e\n\u003c/a\u003e\n\u003c/nav\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"px-2 text-[9px] font-mono text-gray-500 uppercase tracking-widest mb-1.5 font-bold\"\u003e\n        工控支撑工具\n      \u003c/div\u003e\n\u003cnav class=\"space-y-0.5 font-sans\"\u003e\n\u003ca class=\"flex items-center gap-2.5 px-2.5 py-1.5 text-[11.5px] text-gray-400 hover:text-gray-100 hover:bg-[#161922] rounded-[3px] border-l-2 border-transparent transition-colors font-medium\" href=\"#\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[15px]\"\u003etune\u003c/span\u003e\n\u003cspan\u003e残差阈值标定\u003c/span\u003e\n\u003c/a\u003e\n\u003ca class=\"flex items-center gap-2.5 px-2.5 py-1.5 text-[11.5px] text-gray-400 hover:text-gray-100 hover:bg-[#161922] rounded-[3px] border-l-2 border-transparent transition-colors font-medium\" href=\"#\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[15px]\"\u003ereceipt_long\u003c/span\u003e\n\u003cspan\u003e闭环操作日志\u003c/span\u003e\n\u003c/a\u003e\n\u003ca class=\"flex items-center gap-2.5 px-2.5 py-1.5 text-[11.5px] text-gray-400 hover:text-gray-100 hover:bg-[#161922] rounded-[3px] border-l-2 border-transparent transition-colors font-medium\" href=\"#\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[15px]\"\u003edatabase\u003c/span\u003e\n\u003cspan\u003eSCADA点表通道\u003c/span\u003e\n\u003c/a\u003e\n\u003c/nav\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- 底部控制台操作 --\u003e\n\u003cdiv class=\"p-3 border-t border-border-grid bg-[#0A0C10] space-y-2\"\u003e\n\u003cbutton class=\"w-full py-1.5 px-2 bg-[#1C2029] hover:bg-primary hover:text-black text-primary border border-primary/40 rounded-[3px] text-[11px] font-mono font-bold flex items-center justify-center gap-1.5 transition-all\" onclick=\"alert('已重新调取 ThermalNet-Mini 生成最新对比报告快照。')\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[14px]\"\u003eadd_chart\u003c/span\u003e\n      生成新研判报告\n    \u003c/button\u003e\n\u003cdiv class=\"text-[9px] font-mono text-gray-500 text-center flex items-center justify-center gap-1\"\u003e\n\u003cspan\u003eENGINE: ThermalNet-Mini\u003c/span\u003e\n\u003cspan class=\"text-real\"\u003e● v2.3\u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/aside\u003e\n\u003c!-- ==================== 2. 主视口内容区 (SCADA 工业背景) ==================== --\u003e\n\u003cmain class=\"flex-1 min-w-0 flex flex-col scada-grid-bg\"\u003e\n\u003c!-- 顶部工控全局操作栏 (Top Bar) --\u003e\n\u003cheader class=\"h-11 px-4 bg-[#0E1015]/90 border-b border-border-grid flex items-center justify-between gap-4 backdrop-blur-sm sticky top-0 z-30\"\u003e\n\u003cdiv class=\"flex items-center gap-3 min-w-0\"\u003e\n\u003cspan class=\"text-[12px] font-bold text-gray-200 tracking-tight font-sans whitespace-nowrap hidden sm:inline\"\u003e\n        SHAD 智慧供热异常检测与辅助诊断平台\n      \u003c/span\u003e\n\u003cspan class=\"text-gray-600 hidden sm:inline\"\u003e|\u003c/span\u003e\n\u003cdiv class=\"flex items-center gap-1.5 text-[11px] font-mono text-gray-400 truncate\"\u003e\n\u003cspan\u003e北方热力集团\u003c/span\u003e\n\u003cspan class=\"text-gray-600\"\u003e/\u003c/span\u003e\n\u003cspan\u003e城北主力网\u003c/span\u003e\n\u003cspan class=\"text-gray-600\"\u003e/\u003c/span\u003e\n\u003cspan class=\"text-primary font-semibold\"\u003e诊断报告详情 (REP-20261103-018)\u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- 右侧工业 SCADA 状态与操作指示 --\u003e\n\u003cdiv class=\"flex items-center gap-3 shrink-0\"\u003e\n\u003cdiv class=\"flex items-center gap-1.5 px-2 py-0.5 bg-[#121E19] border border-real/40 rounded-[2px] text-real text-[10px] font-mono\"\u003e\n\u003cspan class=\"status-dot-ok\"\u003e\u003c/span\u003e\n\u003cspan class=\"font-bold\"\u003eSCADA 遥测在线 (10s)\u003c/span\u003e\n\u003c/div\u003e\n\u003cdiv class=\"flex items-center gap-1 bg-[#151821] border border-border-grid px-2 py-0.5 rounded-[2px]\"\u003e\n\u003cspan class=\"text-[10px] font-mono text-gray-500\"\u003e源:\u003c/span\u003e\n\u003cspan class=\"text-[10.5px] font-mono text-gray-200\"\u003e模拟运行数据集 (Sim-A)\u003c/span\u003e\n\u003c/div\u003e\n\u003cdiv class=\"px-2 py-0.5 bg-[#161A22] border border-border-grid rounded-[2px] text-primary font-mono text-[11.5px] font-bold tracking-wider\" id=\"liveClock\"\u003e\n        2026-11-03 09:42:18\n      \u003c/div\u003e\n\u003cbutton class=\"w-6 h-6 flex items-center justify-center border border-border-grid bg-[#161922] text-gray-300 hover:text-primary hover:border-primary rounded-[2px] transition-colors\" onclick=\"location.reload()\" title=\"刷新\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[14px]\"\u003erefresh\u003c/span\u003e\n\u003c/button\u003e\n\u003cdiv class=\"flex items-center gap-2 pl-2 border-l border-border-grid\"\u003e\n\u003cdiv class=\"w-5 h-5 rounded-[2px] bg-primary text-black font-mono font-bold text-[10px] flex items-center justify-center\"\u003e\n          07\n        \u003c/div\u003e\n\u003cdiv class=\"text-[10.5px] leading-tight font-mono\"\u003e\n\u003cdiv class=\"text-gray-200 font-semibold\"\u003e张工 (热网调度)\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u0