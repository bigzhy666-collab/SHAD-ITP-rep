  "dataString": "\u003c!DOCTYPE html\u003e\n\n\u003chtml class=\"dark\" lang=\"zh-CN\"\u003e\u003chead\u003e\n\u003cmeta charset=\"utf-8\"/\u003e\n\u003cmeta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/\u003e\n\u003ctitle\u003eSHAD 智慧供热诊断平台 - 异常检测任务详情与研判\u003c/title\u003e\n\u003c!-- Google Fonts: Space Grotesk, Barlow Condensed, JetBrains Mono, Inter --\u003e\n\u003clink href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/\u003e\n\u003clink crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/\u003e\n\u003clink href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700&amp;family=JetBrains+Mono:wght@400;500;600;700&amp;family=Space+Grotesk:wght@500;600;700&amp;display=swap\" rel=\"stylesheet\"/\u003e\n\u003c!-- Material Symbols Outlined --\u003e\n\u003clink href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/\u003e\n\u003c!-- Tailwind CSS CDN --\u003e\n\u003cscript src=\"https://cdn.tailwindcss.com?plugins=forms,container-queries\"\u003e\u003c/script\u003e\n\u003cscript id=\"tailwind-config\"\u003e\n  tailwind.config = {\n    darkMode: \"class\",\n    theme: {\n      extend: {\n        colors: {\n          \"surface-base\": \"#0A0B0E\",\n          \"surface-canvas\": \"#101116\",\n          \"surface-card\": \"#14161B\",\n          \"surface-card-hover\": \"#1C1F26\",\n          \"surface-container\": \"#1B1D23\",\n          \"border-subtle\": \"#1B1D23\",\n          \"border-grid\": \"#2B2E36\",\n          \"primary\": \"#FB7A18\",\n          \"primary-container\": \"#FB7A18\",\n          \"primary-dim\": \"#FFB877\",\n          \"metric-supply\": \"#FF7849\",\n          \"metric-supply-deep\": \"#C62828\",\n          \"metric-return\": \"#00B4D8\",\n          \"metric-pressure\": \"#7C3AED\",\n          \"metric-flow\": \"#4EA8FF\",\n          \"urgent\": \"#EF4444\",\n          \"critical\": \"#F97316\",\n          \"warning\": \"#F59E0B\",\n          \"real\": \"#10B981\",\n          \"on-surface\": \"#E8E9ED\",\n          \"on-surface-variant\": \"#C3C6CD\",\n          \"outline\": \"#8B8F99\"\n        },\n        fontFamily: {\n          sans: [\"Space Grotesk\", \"Barlow Condensed\", \"system-ui\", \"sans-serif\"],\n          mono: [\"JetBrains Mono\", \"monospace\"],\n          condensed: [\"Barlow Condensed\", \"sans-serif\"]\n        },\n        borderRadius: {\n          DEFAULT: \"4px\",\n          sm: \"2px\",\n          md: \"4px\",\n          lg: \"4px\",\n          xl: \"4px\"\n        }\n      }\n    }\n  }\n\u003c/script\u003e\n\u003cstyle\u003e\n  :root {\n    --surface-base: #0A0B0E;\n    --surface-canvas: #101116;\n    --surface-card: #14161B;\n    --border-grid: #2B2E36;\n    --primary: #FB7A18;\n    --urgent: #EF4444;\n    --real: #10B981;\n  }\n  * { box-sizing: border-box; }\n  body {\n    background-color: var(--surface-base);\n    color: #E8E9ED;\n    font-family: 'Space Grotesk', -apple-system, sans-serif;\n    font-variant-numeric: tabular-nums;\n    -webkit-font-smoothing: antialiased;\n    min-height: 100vh;\n  }\n  ::selection {\n    background: rgba(251, 122, 24, 0.35);\n    color: #FFFFFF;\n  }\n  /* 40px 精细工控网格背景 */\n  .scada-grid-bg {\n    background-color: #101116;\n    background-image:\n      linear-gradient(to right, rgba(43, 46, 54, 0.28) 1px, transparent 1px),\n      linear-gradient(to bottom, rgba(43, 46, 54, 0.28) 1px, transparent 1px);\n    background-size: 40px 40px;\n  }\n  .chart-grid-pattern {\n    background-image:\n      linear-gradient(to right, rgba(43, 46, 54, 0.40) 1px, transparent 1px),\n      linear-gradient(to bottom, rgba(43, 46, 54, 0.40) 1px, transparent 1px);\n    background-size: 40px 32px;\n  }\n  /* 工控发光与状态阴影 */\n  .glow-cyan { filter: drop-shadow(0 0 5px rgba(0, 180, 216, 0.55)); }\n  .glow-orange { filter: drop-shadow(0 0 6px rgba(251, 122, 24, 0.45)); }\n  .glow-urgent { filter: drop-shadow(0 0 7px rgba(239, 68, 68, 0.65)); }\n  .glow-warn { filter: drop-shadow(0 0 6px rgba(245, 158, 11, 0.55)); }\n  \n  /* 紧凑工控卡片 */\n  .scada-card {\n    background: #14161B;\n    border: 1px solid #2B2E36;\n    border-radius: 4px;\n    position: relative;\n    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.45);\n  }\n  .scada-card:hover {\n    border-color: #383D48;\n  }\n  /* 滚动条 */\n  ::-webkit-scrollbar { width: 5px; height: 5px; }\n  ::-webkit-scrollbar-track { background: #0A0B0E; }\n  ::-webkit-scrollbar-thumb { background: #2B2E36; border-radius: 2px; }\n  ::-webkit-scrollbar-thumb:hover { background: #FB7A18; }\n\u003c/style\u003e\n\u003c/head\u003e\n\u003cbody class=\"bg-surface-base text-on-surface antialiased min-h-screen flex selection:bg-primary/30\"\u003e\n\u003c!-- ========================================================\n     1. SCADA 经典工控侧边导航栏 (236px / #101116)\n======================================================== --\u003e\n\u003caside class=\"w-[236px] shrink-0 bg-surface-canvas border-r border-border-grid flex flex-col h-screen sticky top-0 z-40 select-none\"\u003e\n\u003c!-- Brand Header --\u003e\n\u003cdiv class=\"px-3.5 py-3 border-b border-border-grid flex items-center gap-2.5\"\u003e\n\u003c!-- 折线目标工控LOGO --\u003e\n\u003cdiv class=\"w-8 h-8 rounded-[4px] bg-[#16181E] border border-border-grid flex items-center justify-center shrink-0\"\u003e\n\u003csvg height=\"22\" viewbox=\"0 0 28 22\" width=\"28\"\u003e\n\u003cline stroke=\"#2B2E36\" stroke-width=\"1\" x1=\"2\" x2=\"26\" y1=\"18\" y2=\"18\"\u003e\u003c/line\u003e\n\u003cpolyline fill=\"none\" points=\"3,15 7,15 11,5 15,16 19,9 25,9\" stroke=\"#FB7A18\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.2\"\u003e\u003c/polyline\u003e\n\u003ccircle cx=\"11\" cy=\"5\" fill=\"#EF4444\" r=\"2.2\" stroke=\"#FFF\" stroke-width=\"0.8\"\u003e\u003c/circle\u003e\n\u003c/svg\u003e\n\u003c/div\u003e\n\u003cdiv class=\"min-w-0 flex-1\"\u003e\n\u003cdiv class=\"text-[13px] font-bold text-white tracking-wide font-sans flex items-center justify-between\"\u003e\n\u003cspan\u003eSHAD · SMART\u003c/span\u003e\n\u003cspan class=\"text-[9px] px-1 py-0.2 bg-primary/20 text-primary border border-primary/40 font-mono rounded-[2px]\"\u003eV0.14\u003c/span\u003e\n\u003c/div\u003e\n\u003cdiv class=\"text-[9px] text-outline font-mono tracking-tight flex items-center gap-1.5 mt-0.5\"\u003e\n\u003cspan class=\"w-1.5 h-1.5 rounded-full bg-real inline-block animate-pulse\"\u003e\u003c/span\u003e\n\u003cspan class=\"truncate\"\u003eCONSOLE · 模拟数据\u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- 管网受析锚定微卡 --\u003e\n\u003cdiv class=\"mx-2.5 mt-2.5 p-2 bg-[#12141A] border border-border-grid rounded-[4px]\"\u003e\n\u003cdiv class=\"flex items-center justify-between text-[9px] font-mono text-primary font-semibold mb-1\"\u003e\n\u003cspan class=\"flex items-center gap-1\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[11px]\"\u003edevice_hub\u003c/span\u003e\n        受析管段 (PRD N-01)\n      \u003c/span\u003e\n\u003cspan class=\"text-real text-[8.5px] font-mono\"\u003eSCADA 联动\u003c/span\u003e\n\u003c/div\u003e\n\u003cdiv class=\"text-[11px] font-bold text-gray-200 truncate font-mono\"\u003e1号二次供热管段 (DN300)\u003c/div\u003e\n\u003cdiv class=\"text-[9px] text-outline font-mono mt-0.5 flex justify-between\"\u003e\n\u003cspan\u003e城北主力网 · K2+140\u003c/span\u003e\n\u003cspan class=\"text-primary-dim\"\u003e桩号: #029\u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- 导航条目区 --\u003e\n\u003cdiv class=\"flex-1 overflow-y-auto px-2 py-2.5 space-y-3\"\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"px-2 text-[9px] font-mono text-outline uppercase tracking-wider mb-1 font-bold\"\u003e\n        核心监测模块\n      \u003c/div\u003e\n\u003cnav class=\"space-y-1\"\u003e\n\u003c!-- 1. 总览看板 (Inactive) --\u003e\n\u003ca class=\"flex items-center gap-2.5 px-2.5 py-1.5 text-[11.5px] text-on-surface-variant hover:text-white hover:bg-surface-card-hover rounded-[4px] border-l-2 border-transparent transition-colors font-medium\" href=\"#\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[15px]\"\u003edashboard\u003c/span\u003e\n\u003cspan\u003e总览看板 (Overview)\u003c/span\u003e\n\u003c/a\u003e\n\u003c!-- 2. 管网管理 (Inactive) --\u003e\n\u003ca class=\"flex items-center gap-2.5 px-2.5 py-1.5 text-[11.5px] text-on-surface-variant hover:text-white hover:bg-surface-card-hover rounded-[4px] border-l-2 border-transparent transition-colors font-medium\" href=\"#\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[15px]\"\u003ehub\u003c/span\u003e\n\u003cspan\u003e管网拓扑管理\u003c/span\u003e\n\u003c/a\u003e\n\u003c!-- 3. 异常检测 (ACTIVE: #FB7A18 橙底黑字高亮 + 警示数字角标) --\u003e\n\u003ca class=\"flex items-center justify-between px-2.5 py-1.5 text-[11.5px] font-bold rounded-[4px] bg-[#FB7A18] text-[#100600] border-l-2 border-white shadow-sm\" href=\"#\"\u003e\n\u003cdiv class=\"flex items-center gap-2.5\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[15px] text-[#100600]\"\u003ewarning\u003c/span\u003e\n\u003cspan\u003e异常检测研判\u003c/span\u003e\n\u003c/div\u003e\n\u003cspan class=\"text-[9px] font-mono px-1 py-0.2 bg-black/25 text-[#100600] border border-black/40 rounded-[2px] font-bold\"\u003e2 待研判\u003c/span\u003e\n\u003c/a\u003e\n\u003c!-- 4. AI 分析 (Inactive) --\u003e\n\u003ca class=\"flex items-center gap-2.5 px-2.5 py-1.5 text-[11.5px] text-on-surface-variant hover:text-white hover:bg-surface-card-hover rounded-[4px] border-l-2 border-transparent transition-colors font-medium\" href=\"#\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[15px]\"\u003epsychology\u003c/span\u003e\n\u003cspan\u003e自研小模型 AI 诊断\u003c/span\u003e\n\u003c/a\u003e\n\u003c!-- 5. 诊断报告 (Inactive) --\u003e\n\u003ca class=\"flex items-center gap-2.5 px-2.5 py-1.5 text-[11.5px] text-on-surface-variant hover:text-white hover:bg-surface-card-hover rounded-[4px] border-l-2 border-transparent transition-colors font-medium\" href=\"#\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[15px]\"\u003eassessment\u003c/span\u003e\n\u003cspan\u003e诊断报告归档\u003c/span\u003e\n\u003c/a\u003e\n\u003c/nav\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"px-2 text-[9px] font-mono text-outline uppercase tracking-wider mb-1 font-bold\"\u003e\n        工控支撑工具\n      \u003c/div\u003e\n\u003cnav class=\"space-y-0.5\"\u003e\n\u003ca class=\"flex items-center gap-2.5 px-2.5 py-1.5 text-[11.5px] text-on-surface-variant hover:text-white hover:bg-surface-card-hover rounded-[4px] border-l-2 border-transparent transition-colors font-medium\" href=\"#\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[15px]\"\u003etune\u003c/span\u003e\n\u003cspan\u003e残差阈值标定\u003c/span\u003e\n\u003c/a\u003e\n\u003ca class=\"flex items-center gap-2.5 px-2.5 py-1.5 text-[11.5px] text-on-surface-variant hover:text-white hover:bg-surface-card-hover rounded-[4px] border-l-2 border-transparent transition-colors font-medium\" href=\"#\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[15px]\"\u003ereceipt_long\u003c/span\u003e\n\u003cspan\u003e闭环操作日志\u003c/span\u003e\n\u003c/a\u003e\n\u003ca class=\"flex items-center gap-2.5 px-2.5 py-1.5 text-[11.5px] text-on-surface-variant hover:text-white hover:bg-surface-card-hover rounded-[4px] border-l-2 border-transparent transition-colors font-medium\" href=\"#\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[15px]\"\u003edatabase\u003c/span\u003e\n\u003cspan\u003eSCADA点表通道\u003c/span\u003e\n\u003c/a\u003e\n\u003c/nav\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- 底部报告与引擎指标 --\u003e\n\u003cdiv class=\"p-2.5 border-t border-border-grid bg-[#0A0C10] space-y-1.5\"\u003e\n\u003cbutton class=\"w-full py-1.5 px-2 bg-[#1C2029] hover:bg-primary hover:text-black text-primary border border-primary/40 rounded-[4px] text-[11px] font-mono font-bold flex items-center justify-center gap-1.5 transition-all\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[14px]\"\u003epicture_as_pdf\u003c/span\u003e\n\u003cspan\u003e一键生成分析报告\u003c/span\u003e\n\u003c/button\u003e\n\u003cdiv class=\"text-[9px] font-mono text-outline text-center flex items-center justify-center gap-1\"\u003e\n\u003cspan\u003eENGINE: ThermalNet-Mini\u003c/span\u003e\n\u003cspan class=\"text-real font-bold\"\u003e● v2.3\u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/aside\u003e\n\u003c!-- ========================================================\n     2. 主视图画布 (SCADA 40px 精细网格背景)\n======================================================== --\u003e\n\u003cdiv class=\"flex-1 min-w-0 flex flex-col scada-grid-bg\"\u003e\n\u003c!-- 顶部工控操作栏 --\u003e\n\u003cheader class=\"h-12 px-3.5 bg-surface-canvas/90 border-b border-border-grid flex items-center justify-between gap-3 sticky top-0 z-30 backdrop-blur-sm\"\u003e\n\u003c!-- 左侧标题与对象导航 --\u003e\n\u003cdiv class=\"flex items-center gap-3 min-w-0\"\u003e\n\u003cspan class=\"text-[13px] font-bold text-gray-200 tracking-tight whitespace-nowrap\"\u003e\n        SHAD 智慧供热异常检测与辅助诊断平台\n      \u003c/span\u003e\n\u003cspan class=\"text-border-grid hidden sm:inline\"\u003e|\u003c/span\u003e\n\u003cdiv class=\"flex items-center gap-1 text-[11px] font-mono text-outline truncate\"\u003e\n\u003cspan\u003e北方热力集团\u003c/span\u003e\n\u003cspan class=\"text-border-grid\"\u003e/\u003c/span\u003e\n\u003cspan\u003e城北主力网\u003c/span\u003e\n\u003cspan class=\"text-border-grid\"\u003e/\u003c/span\u003e\n\u003cspan class=\"text-primary font-semibold\"\u003e1号二次供热管段 (DN300)\u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- 右侧 SCADA 状态与操作指示 --\u003e\n\u003cdiv class=\"flex items-center gap-2.5 shrink-0\"\u003e\n\u003c!-- 遥测在线心跳 --\u003e\n\u003cdiv class=\"flex items-center gap-1.5 px-2 py-0.5 bg-[#121E19] border border-real/40 rounded-[4px] text-real text-[10px] font-mono\"\u003e\n\u003cspan class=\"w-1.5 h-1.5 rounded-full bg-real inline-block shadow-[0_0_6px_rgba(16,185,129,0.8)] animate-pulse\"\u003e\u003c/span\u003e\n\u003cspan class=\"font-bold\"\u003eSCADA 遥测在线 (10s)\u003c/span\u003e\n\u003c/div\u003e\n\u003c!-- 数据源通道 --\u003e\n\u003cdiv class=\"flex items-center gap-1 bg-[#151821] border border-border-grid px-2 py-0.5 rounded-[4px]\"\u003e\n\u003cspan class=\"text-[10px] font-mono text-outline\"\u003e源:\u003c/span\u003e\n\u003cspan class=\"text-[10.5px] font-mono text-gray-200\"\u003e时序残差切片 (TRC-SimA)\u003c/span\u003e\n\u003c/div\u003e\n\u003c!-- 工控等宽数字时钟 --\u003e\n\u003cdiv class=\"px-2 py-0.5 bg-[#161A22] border border-border-grid rounded-[4px] text-primary font-mono text-[11.5px] font-bold tracking-wider\" id=\"clock\"\u003e\n        2026-11-03 08:35:12\n      \u003c/div\u003e\n\u003c!-- 刷新按钮 --\u003e\n\u003cbutton class=\"w-6 h-6 flex items-center justify-center border border-border-grid bg-[#161922] text-on-surface-variant hover:text-primary hover:border-primary rounded-[4px] transition-colors\" title=\"强制刷新采样\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[14px]\"\u003erefresh\u003c/span\u003e\n\u003c/button\u003e\n\u003c!-- 值班专家席位 --\u003e\n\u003cdiv class=\"flex items-center gap-1.5 pl-2 border-l border-border-grid\"\u003e\n\u003cdiv class=\"w-5 h-5 rounded-[2px] bg-primary text-black font-mono font-bold text-[10px] flex items-center justify-center\"\u003e\n          07\n        \u003c/div\u003e\n\u003cdiv class=\"text-[10.5px] font-mono text-gray-200 font-semibold hidden md:block\"\u003e\n          张工 (热网调度)\n        \u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/header\u003e\n\u003c!-- 主体工作区容器 --\u003e\n\u003cmain class=\"p-3 space-y-3 flex-1 overflow-y-auto\"\u003e\n\u003c!-- ==================== 1. 任务上下文与管网切换横幅 (4px 圆角) ==================== --\u003e\n\u003csection class=\"scada-card p-2 flex flex-wrap items-center justify-between gap-2.5 bg-[#12141A]\"\u003e\n\u003cdiv class=\"flex items-center gap-2 flex-wrap text-[11px] font-mono\"\u003e\n\u003c!-- 任务编号 Badge --\u003e\n\u003cdiv class=\"flex items-center gap-1.5 bg-[#171A22] border border-border-grid px-2.5 py-1 rounded-[4px]\"\u003e\n\u003cspan class=\"material-symbols-outlined text-primary text-[14px]\"\u003eterminal\u003c/span\u003e\n\u003cspan class=\"text-outline\"\u003e检测任务编号:\u003c/span\u003e\n\u003cspan class=\"font-bold text-primary\"\u003eDET-20261103-089\u003c/span\u003e\n\u003c/div\u003e\n\u003c!-- 三级管网层级面包屑 --\u003e\n\u003cdiv class=\"flex items-center gap-1.5 bg-[#171A22] border border-border-grid px-2.5 py-1 rounded-[4px]\"\u003e\n\u003cspan class=\"text-outline\"\u003e企业: 北方热力有限责任公司\u003c/span\u003e\n\u003cspan class=\"text-border-grid\"\u003e→\u003c/span\u003e\n\u003cspan class=\"text-outline\"\u003e管网: 城北主力网 (二次网)\u003c/span\u003e\n\u003cspan class=\"text-border-grid\"\u003e→\u003c/span\u003e\n\u003cspan class=\"text-primary font-bold\"\u003e1号二次供热管段 (DN300 · K2+140)\u003c/span\u003e\n\u003c/div\u003e\n\u003c!-- 状态指示 --\u003e\n\u003cdiv class=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-[4px] bg-urgent/15 border border-urgent/40 text-urgent font-bold\"\u003e\n\u003cspan class=\"w-1.5 h-1.5 rounded-full bg-urgent glow-urgent animate-pulse\"\u003e\u003c/span\u003e\n\u003cspan\u003e检测状态: 成功 (检出 2 处时序残差异常)\u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- 右侧快捷指令群 --\u003e\n\u003cdiv class=\"flex items-center gap-2\"\u003e\n\u003cbutton class=\"px-2.5 py-1 rounded-[4px] bg-[#171A21] hover:bg-[#20242E] text-on-surface-variant hover:text-white border border-border-grid text-[11px] font-mono font-semibold flex items-center gap-1.5 transition-all\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[13px]\"\u003econtent_copy\u003c/span\u003e\n\u003cspan\u003e复制配置\u003c/span\u003e\n\u003c/button\u003e\n\u003cbutton class=\"px-2.5 py-1 rounded-[4px] bg-[#171A21] hover:bg-[#20242E] text-on-surface-variant hover:text-white border border-border-grid text-[11px] font-mono font-semibold flex items-center gap-1.5 transition-all\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[13px]\"\u003efile_download\u003c/span\u003e\n\u003cspan